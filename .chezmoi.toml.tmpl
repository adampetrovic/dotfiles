{{- /* profile detection */ -}}
{{- $profiles := list "personal" "work" -}}
{{- $profile := promptChoiceOnce . "profile" "Select a profile" $profiles -}}
{{- $email := promptStringOnce . "email" "What is your email address" -}}
{{- $brewPrefix := "/usr/local" -}}
{{- if eq .chezmoi.arch "arm64" -}}
{{- $brewPrefix = "/opt/homebrew" -}}
{{- end -}}

{{- if eq $profile "personal" -}}
[onepassword]
    command = "{{ $brewPrefix }}/bin/op"
{{- end }}

{{- if eq $profile "work" -}}
[keeper]
    args = ["--config", {{ printf "%s/Library/Application Support/.keeper/config.json" .chezmoi.homeDir | quote }}, "--batch-mode"]
{{- end }}

[update]
    command = "jj"
    args = ["restack"]

[data]
    full_name = "Adam Petrovic"
    profile = {{ $profile | quote }}
    work = {{ eq $profile "work" }}
    personal = {{ eq $profile "personal" }}
    email = {{ $email | quote }}

[hooks.read-source-state.pre]
    command = ".local/share/chezmoi/.install-password-manager.sh"
    args = [{{ $profile | quote }}, {{ $email | quote }}]
