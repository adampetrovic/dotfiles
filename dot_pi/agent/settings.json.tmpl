{
  "lastChangelogVersion": "1.3.0",
  "defaultProvider": "{{ if .personal }}openai-codex{{ else }}anthropic{{ end }}",
  "defaultModel": "{{ if .personal }}gpt-6.1-sol{{ else }}claude-opus-5-5{{ end }}",
  "defaultThinkingLevel": "medium",
  "defaultTools": ["+codemode"],
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 12000
  },
  "observational-memory": {
    "observeAfterTokens": 5000,
    "compactAfterTokens": 150000,
    "compactAfterTokensMode": "calibrated",
    "model": {
      "provider": "openai-codex",
      "id": "gpt-6-luna",
      "thinking": "low"
    },
    "passive": false,
    "debugLog": false
  },
  "extensions": ["-extensions/notify.ts"],
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-btw",
    "npm:@tintinweb/pi-subagents",
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:@plannotator/pi-extension",
    "npm:pi-observational-memory"{{ if .personal }},
    "npm:@narumitw/pi-usage"{{ end }},
    {
      "source": "npm:mitsupi",
      "extensions": [
        "extensions/todos.ts"
      ],
      "skills": [],
      "prompts": [],
      "themes": []
    }
  ],
  "theme": "dark",
  "warnings": {
    "anthropicExtraUsage": false
  }
}
