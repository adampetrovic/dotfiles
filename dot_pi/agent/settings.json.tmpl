{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "{{ if .work }}gpt-5.6-sol{{ else }}gpt-5.5{{ end }}",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 12000
  },
  "observational-memory": {
    "chunkTokens": 5000,
    "chunkOverlapTokens": 0,
    "poolTargetTokens": 10000,
    "consolidateAtPoolTokens": 20000,
    "compactAtContextTokens": 100000,
    "tailTokens": 20000,
    "journeyTargetTokens": 1000,
    "observerConcurrency": 4,
    "resumeAfterMidRunCompaction": true,
    "models": {
        "observer": {
            "provider": "openai-codex",
            "id": "gpt-5.6-luna",
            "thinking": "low"
        },
        "consolidator": {
            "provider": "openai-codex",
            "id": "{{ if .work }}gpt-5.6-sol{{ else }}gpt-5.5{{ end }}",
            "thinking": "medium"
        }
    },
    "passive": false,
    "debugLog": false
  },
  "packages": [
    "npm:@juicesharp/rpiv-btw",
    "npm:@tintinweb/pi-subagents",
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:@plannotator/pi-extension",
    "https://github.com/amosblomqvist/pi-observational-memory"{{ if .personal }},
    "npm:@narumitw/pi-usage"{{ end }},
    {
      "source": "npm:mitsupi",
      "extensions": [
        "extensions/todos.ts"
      ],
      "skills": [],
      "prompts": [],
      "themes": []
    }
  ],
  "theme": "dark"
}
