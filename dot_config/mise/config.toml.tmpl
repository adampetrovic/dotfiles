[tools]
golang = '1.24'
python = '3.13'
node = "22.22.3"
age = "1.3.1"
rust = '1.89.0'
gh = 'latest'
atuin = 'latest'
bat = 'latest'
delta = 'latest'
difftastic = 'latest'
doggo = 'latest'
fzf = 'latest'
gron = 'latest'
gum = 'latest'
jjui = 'latest'
jq = 'latest'
krew = 'latest'
kubectl = 'latest'
ripgrep = 'latest'
sops = 'latest'
yq = 'latest'
zoxide = 'latest'
# jjc: non-interactive hunk-level operations for Jujutsu — https://tangled.org/akashina.tngl.sh/jjc
# Pinned by rev (repo has no tags); bump the rev to update.
"cargo:https://tangled.sh/akashina.tngl.sh/jjc" = { version = "rev:492e0223d03b9e5b3fe3f33389da77b9e2e7f68f" }
{{ if .work -}}
java = 'corretto-17.0.15.6.1'
{{ end -}}

[settings]
idiomatic_version_file_enable_tools = ["java"]

[env]
HOMEBREW_GITHUB_API_TOKEN = {{ onepasswordRead "op://Private/Github/HOMEBREW_GITHUB_API_TOKEN" | quote }}
{{ if .personal -}}
TELEGRAM_BOT_TOKEN = {{ onepasswordRead "op://Private/Telegram Bot - Pi/token" | quote }}
TELEGRAM_CHAT_ID = {{ onepasswordRead "op://Private/Telegram Bot - Pi/chat_id" | quote }}
LOGSEQ_API_SERVER_TOKEN = {{ onepasswordRead "op://Private/Logseq/LOGSEQ_API_TOKEN" | quote }}
{{ end -}}
