[tools]
golang = '1.24'
python = '3.13'
node = "22.22.3"
rust = '1.89.0'
gh = 'latest'
# Google Workspace CLI (provides `gws`); use GitHub backend because it is not in the mise registry.
"github:googleworkspace/cli" = "0.22.5"
atuin = 'latest'
bat = 'latest'
delta = 'latest'
difftastic = 'latest'
doggo = 'latest'
fzf = 'latest'
gron = 'latest'
gum = 'latest'
jjui = 'latest'
jq = 'latest'
krew = 'latest'
kubectl = 'latest'
k9s = 'latest'
ripgrep = 'latest'
yq = 'latest'
zoxide = 'latest'
# jjc: non-interactive hunk-level operations for Jujutsu — https://tangled.org/akashina.tngl.sh/jjc
# Pinned by rev (repo has no tags); bump the rev to update.
"cargo:https://tangled.sh/akashina.tngl.sh/jjc" = { version = "rev:bb71fdcd704e8bf4ddfac9ac0e3a036cab441b2c" }
{{ if .work -}}
java = 'corretto-17.0.15.6.1'
{{ end -}}

[settings]
idiomatic_version_file_enable_tools = ["java"]

[env]
{{ if .personal -}}
{{ $githubToken := onepasswordRead "op://Private/Github/HOMEBREW_GITHUB_API_TOKEN" -}}
GITHUB_TOKEN = {{ $githubToken | quote }}
HOMEBREW_GITHUB_API_TOKEN = {{ $githubToken | quote }}
TELEGRAM_BOT_TOKEN = {{ onepasswordRead "op://Private/Telegram Bot - Pi/token" | quote }}
TELEGRAM_CHAT_ID = {{ onepasswordRead "op://Private/Telegram Bot - Pi/chat_id" | quote }}
LOGSEQ_API_SERVER_TOKEN = {{ onepasswordRead "op://Private/Logseq/LOGSEQ_API_TOKEN" | quote }}
{{ else if .work -}}
{{ $githubToken := keeperFindPassword "2Esevx_bdHUIvptdaFTFxg" -}}
GITHUB_TOKEN = {{ $githubToken | quote }}
HOMEBREW_GITHUB_API_TOKEN = {{ $githubToken | quote }}
{{ end -}}
