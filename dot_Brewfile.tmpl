{{/* base level packages for all environments */}}
{{- $taps := list -}}

{{- $customTaps := dict -}}

{{- $brews := list
    "bind"
    "chezmoi"
    "coreutils"
    "dockutil"
    "entr"
    "git"
    "git-extras"
    "gnu-sed"
    "grep"
    "httpie"
    "httpstat"
    "jj"
    "mise"
    "pipenv"
    "rsync"
    "skopeo"
    "vim"
    "watch"
    "wget"
    "lucasgelfond/zerobrew/zerobrew"
    "zsh" -}}

{{- $casks := list
    "1password"
    "1password-cli"
    "alfred"
    "cleanshot"
    "docker-desktop"
    "fantastical"
    "font-jetbrains-mono"
    "ghostty"
    "goland"
    "intellij-idea"
    "logseq"
    "mitmproxy"
    "pycharm"
    "rectangle-pro"
    "thaw"
    "adampetrovic/tap/things"
    "webstorm" -}}

{{- $mas := dict -}}

{{- $brewsWithArgs := dict -}}

{{/* personal-specific packages */}}
{{- if .personal -}}
{{- $taps = concat $taps (list) -}}

{{-  $brews = concat $brews (list
    "mas"
    "adampetrovic/tap/pi-telegram-bot"
    "adampetrovic/tap/stash-sync") -}}

{{  $brewsWithArgs = merge $brewsWithArgs (dict) -}}

{{-  $casks = concat $casks (list
    "bambu-studio"
    "brave-browser"
    "calibre"
    "claude"
    "claude-code"
    "google-chrome"
    "helium-browser"
    "home-assistant"
    "istat-menus"
    "keepingyouawake"
    "keyboardcleantool"
    "kindle-previewer"
    "macwhisper"
    "telegram"
    "voiceink") -}}

{{-  $mas = merge $mas (dict
    "EventScripts" "525319418"
    "Reeder Classic." "1529448980"
    "Wireguard" "1451685025") -}}
{{- end -}}


{{/* work-specific packages */}}
{{- if .work -}}
{{- $taps = concat $taps (list) -}}

{{  $customTaps = merge $customTaps (dict) -}}

{{  $brews = concat $brews (list
    "awscli"
    "gcloud-cli") -}}

{{  $brewsWithArgs = merge $brewsWithArgs (dict
    "adampetrovic/tap/work-scripts" (list "HEAD")) -}}

{{  $casks = concat $casks (list
    "loom") -}}

{{  $mas = merge $mas (dict) -}}
{{- end -}}

{{ range ($taps | sortAlpha | uniq) -}}
tap "{{ . }}"
{{ end }}
{{ range $name, $url := $customTaps -}}
tap "{{ $name }}", "{{ $url }}"
{{ end -}}
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end }}
{{ range $name, $args := $brewsWithArgs -}}
brew "{{ $name }}", args: {{ $args | toJson }}
{{ end }}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end }}
{{ range $app, $id := $mas -}}
mas "{{ $app }}", id: {{ $id }}
{{ end }}
