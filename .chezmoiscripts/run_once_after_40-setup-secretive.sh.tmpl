{{ if .work -}}
#!/bin/bash

set -euo pipefail

SIGNING_PUB="{{ .chezmoi.homeDir }}/.ssh/secretive_signing.pub"
ALLOWED="{{ .chezmoi.homeDir }}/.ssh/git_allowed_signers"

if [ -f "$SIGNING_PUB" ]; then
    exit 0
fi

cat <<'MSG'

=== Secretive SSH key setup (work) ===
Secretive stores SSH keys in the Secure Enclave and serves them over its agent.
  1. Open Secretive (installed via Homebrew), grant it the permissions it asks for.
  2. Click "+" to create a new key.
  3. Select the key and copy its "Public Key Path".
MSG

while :; do
    read -r -p "Paste the Public Key Path from Secretive: " pubpath
    pubpath="${pubpath/#\~/$HOME}"
    [ -f "$pubpath" ] && break
    echo "No file found at: $pubpath — try again (Ctrl-C to abort)." >&2
done

mkdir -p "{{ .chezmoi.homeDir }}/.ssh"
cp "$pubpath" "$SIGNING_PUB"
chmod 644 "$SIGNING_PUB"
echo "{{ .email }} $(cat "$SIGNING_PUB")" > "$ALLOWED"

cat <<MSG

Your Secretive public key (one key, used everywhere):

$(cat "$SIGNING_PUB")

Add it to:
  - GitHub    -> https://github.com/settings/keys
                add it as BOTH an "Authentication key" AND a "Signing key"
  - Bitbucket -> Personal settings > SSH keys (Authentication)
MSG

read -r -p "Press Enter once you've added it to GitHub and Bitbucket... "
echo "Saved signing key to $SIGNING_PUB"
{{ end -}}
