#!/bin/bash

set -eufo pipefail
{{ template "log.sh" . }}
log_step "Setting up jujutsu (colocated repo)"

BREW_PREFIX="{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}"
eval "$("$BREW_PREFIX/bin/brew" shellenv)"

SRC="{{ .chezmoi.sourceDir }}"

git -C "$SRC" remote set-url origin git@github.com:adampetrovic/dotfiles.git

if [ ! -d "$SRC/.jj" ]; then
    log_info "Initializing colocated jujutsu repo in $SRC"
    ( cd "$SRC" && jj git init --colocate )
fi
