{{- if .work -}}
#!/bin/bash

set -eufo pipefail
{{ template "log.sh" . }}
log_step "Installing required work apps from Jamf Self Service"

JAMF_BIN="/usr/local/bin/jamf"
missing_policy_ids=()
missing_policy_names=()

app_installed() {
    [ -d "/Applications/$1.app" ] || [ -d "$HOME/Applications/$1.app" ]
}

queue_if_missing() {
    local name="$1"
    local policy_id="$2"
    local check_type="$3"
    local check_value="$4"

    case "$check_type" in
        app)
            app_installed "$check_value" && return 0
            ;;
        command)
            command -v "$check_value" >/dev/null 2>&1 && return 0
            ;;
        *)
            log_warn "Unknown installation check type for $name: $check_type"
            return 1
            ;;
    esac

    missing_policy_ids+=("$policy_id")
    missing_policy_names+=("$name")
}

verify_installed() {
    local name="$1"
    local check_type="$2"
    local check_value="$3"

    case "$check_type" in
        app)
            app_installed "$check_value"
            ;;
        command)
            command -v "$check_value" >/dev/null 2>&1
            ;;
    esac || {
        log_warn "$name is still missing after its Jamf policy completed"
        return 1
    }
}

if [ ! -x "$JAMF_BIN" ]; then
    log_warn "Jamf is not installed at $JAMF_BIN; this work Mac may not be enrolled"
    exit 1
fi

# Policy IDs discovered from the local Self Service catalogue.
queue_if_missing "Keeper Password Manager" "1085" app "Keeper Password Manager"
queue_if_missing "Keeper Commander CLI" "1096" command "keeper"
queue_if_missing "Secretive" "1073" app "Secretive"

if [ "${#missing_policy_ids[@]}" -gt 0 ]; then
    for name in "${missing_policy_names[@]}"; do
        log_info "Installing $name from Jamf Self Service"
    done

    # Run all missing policies through one root shell so work machines only need
    # one administrator-password prompt, even when sudo caching is disabled.
    /usr/bin/sudo /bin/bash -s -- "$JAMF_BIN" "${missing_policy_ids[@]}" <<'ROOT'
set -euo pipefail
jamf_bin="$1"
shift
for policy_id in "$@"; do
    "$jamf_bin" policy -id "$policy_id"
done
ROOT
fi

verify_installed "Keeper Password Manager" app "Keeper Password Manager"
verify_installed "Keeper Commander CLI" command "keeper"
verify_installed "Secretive" app "Secretive"

log_ok "Required work Self Service apps are installed"
{{- end }}
