{{ if (eq .chezmoi.os "darwin" "linux") -}}
#!/usr/bin/env bash

set -Eeuo pipefail
{{ template "log.sh" . }}
log_step "Installing Herdr plugins"

PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

# Herdr plugins to install (GitHub owner/repo), one per line.
plugins=(
    jeffarese/herdr-bar
)

# Anything already installed (including local links and disabled plugins) is
# left alone; update explicitly with `herdr plugin update`.
installed="$(herdr plugin list --json)"
for repo in "${plugins[@]}"; do
    if ! grep -q "\"repo\":\"${repo#*/}\"" <<<"$installed" || ! grep -q "\"owner\":\"${repo%/*}\"" <<<"$installed"; then
        herdr plugin install "$repo" --yes
    fi
done
{{ end -}}
