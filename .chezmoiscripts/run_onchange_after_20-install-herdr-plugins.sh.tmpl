{{ if (eq .chezmoi.os "darwin" "linux") -}}
#!/usr/bin/env bash

set -Eeuo pipefail
{{ template "log.sh" . }}
log_step "Installing Herdr plugins"

PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

install_plugin() {
    local plugin_id="$1" repo="$2" installed
    installed="$(herdr plugin list --plugin "$plugin_id" --json)"
    # Existing installs, including local links and disabled plugins, are left unchanged; updates are explicit via herdr plugin update.
    if ! printf '%s\n' "$installed" | grep -Eq '"plugin_id"[[:space:]]*:[[:space:]]*"'"$plugin_id"'"'; then
        herdr plugin install "$repo" --yes
    fi
}

install_plugin herdr-bar jeffarese/herdr-bar
{{ end -}}
