#!/bin/bash

set -eufo pipefail
{{ template "log.sh" . }}
log_step "Bootstrap: Homebrew & password manager"

BREW_PREFIX="{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}"

ensure_ssh_agent_config() {
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    touch "$HOME/.ssh/config"
    chmod 600 "$HOME/.ssh/config"

    if ! grep -Fq '2BUA8C4S2C.com.1password/t/agent.sock' "$HOME/.ssh/config"; then
        log_info "Priming SSH config for 1Password agent"
        cat >>"$HOME/.ssh/config" <<'EOF'

Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
EOF
    fi
}

# Install Homebrew
command -v brew >/dev/null 2>&1 || [ -x "$BREW_PREFIX/bin/brew" ] || \
  (echo '🍺  Installing Homebrew' && /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)")

eval "$("$BREW_PREFIX/bin/brew" shellenv)"

{{ if .work -}}
log_warn 'Work profile expects Keeper Password Manager, Keeper Commander CLI (`keeper`), and Secretive to be installed via work Self Service, not Homebrew.'
command -v keeper >/dev/null 2>&1 || log_warn "Keeper Commander CLI is missing; install it from Self Service before rendering Keeper-backed templates."
[ -d "/Applications/Keeper Password Manager.app" ] || [ -d "$HOME/Applications/Keeper Password Manager.app" ] || log_warn "Keeper desktop app is missing; install it from Self Service."
[ -d "/Applications/Secretive.app" ] || [ -d "$HOME/Applications/Secretive.app" ] || log_warn "Secretive is missing; install it from Self Service before using SSH."
{{ else -}}
log_info 'Installing 1Password (cask + cli)'
brew bundle --file=/dev/stdin <<EOF
cask "1password"
cask "1password-cli"
EOF

ensure_ssh_agent_config

if ! op account list 2>/dev/null | grep -q 'my.1password.com'; then
    op account add --address my.1password.com --email "adam@petrovic.com.au"
fi

op signin --account my >/dev/null || log_warn "1Password sign-in did not complete; unlock 1Password and re-run chezmoi apply if secret reads fail"
{{ end -}}
