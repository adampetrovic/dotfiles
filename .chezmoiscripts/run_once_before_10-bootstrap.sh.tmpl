#!/bin/bash

set -eufo pipefail

# Install Homebrew
command -v brew >/dev/null 2>&1 || \
  (echo '🍺  Installing Homebrew' && /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)")

eval "$(/opt/homebrew/bin/brew shellenv)"

echo 'Installing dotfiles dependencies'
brew bundle --file=/dev/stdin <<EOF
cask "1password"
cask "1password-cli"
EOF

# 1Password account that owns the vaults (Private/Work/Shared/k8s) — fixed,
# independent of {{ "{{ .email }}" }} which is the git identity (may be a work email).
op account add --address my.1password.com --email "adam@petrovic.com.au"
eval $(op signin --account my)
