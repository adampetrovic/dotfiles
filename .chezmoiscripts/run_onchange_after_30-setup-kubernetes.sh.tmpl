{{ if .personal -}}
#!/bin/bash

set -eufo pipefail
{{ template "log.sh" . }}
log_step "Setting up Kubernetes (talosctl/kubectl)"

BREW_PREFIX="{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}"
eval "$("$BREW_PREFIX/bin/brew" shellenv)"

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
touch "$HOME/.ssh/config"
chmod 600 "$HOME/.ssh/config"
if ! grep -Fq '2BUA8C4S2C.com.1password/t/agent.sock' "$HOME/.ssh/config"; then
    log_info "Priming SSH config for 1Password agent"
    cat >>"$HOME/.ssh/config" <<'EOF'

Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
EOF
fi

HOME_OPS_DIR="$HOME/code/home-ops"
TALOS_DIR="$HOME_OPS_DIR/talos"

# Step 1: Check if ~/code/home-ops doesn't exist. If it does, skip cloning.
if [ ! -d "$HOME_OPS_DIR" ]; then
    mkdir -p "$HOME/code"
    git clone -q git@github.com:adampetrovic/home-ops.git "$HOME_OPS_DIR"
fi

log_info "Installing home-ops mise tools"
(
    cd "$HOME_OPS_DIR"
    mise trust -y .mise.toml
    mise install
)

# Step 2: Run talhelper to generate config
if [ ! -f "$HOME/.talos/config" ]; then
    (
        cd "$TALOS_DIR"
        op run --env-file=".env" -- mise exec -- talhelper genconfig --debug -c talconfig.yaml -e talenv.yaml -s talsecret.yaml
    )
    # Step 3: Move talosconfig to ~/.talos/config and delete generated node configs
    mkdir -p "$HOME/.talos"
    mv "$TALOS_DIR/clusterconfig/talosconfig" "$HOME/.talos/config"
    find "$TALOS_DIR/clusterconfig" -mindepth 1 -maxdepth 1 ! -name '.gitignore' -type f -delete

    # Step 4: Test the command `talosctl time` runs and exits correctly
    if ! ( cd "$HOME_OPS_DIR" && mise exec -- talosctl time >/dev/null 2>&1 ); then
        echo "talosctl command failed. setup manually"
        exit 1
    fi

else
    echo "talosctl already setup. skipping..."
fi

# Step 5: Run talosctl to generate kubeconfig
if [ ! -f "$HOME/.kube/config" ]; then
    mkdir -p "$HOME/.kube"
    ( cd "$HOME_OPS_DIR" && mise exec -- talosctl kubeconfig -n 10.0.80.10 "$HOME/.kube/config" )

    if ! ( cd "$HOME_OPS_DIR" && mise exec -- kubectl get nodes >/dev/null 2>&1 ); then
        echo "kubectl command failed. setup manually"
        exit 1
    fi
else
    echo "kubectl already setup. skipping..."
fi

if ( cd "$HOME_OPS_DIR" && mise exec -- kubectl krew >/dev/null 2>&1 ); then
    krew_pkgs=(
        "cnpg"
        "klock"
        "rook-ceph"
        "sick-pods"
        "view-secret"
    )
    ( cd "$HOME_OPS_DIR" && mise exec -- kubectl krew install "${krew_pkgs[@]}" )
fi
{{ end -}}
